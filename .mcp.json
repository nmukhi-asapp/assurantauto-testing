{
  "mcpServers": {
    "scenarios": {
      "command": "bash",
      "args": [
        "-c",
        "_DIR=${MCP_REPO_DIR:-$HOME/code/generative-agent-optimization-mcp}; cd \"$_DIR\" && exec /opt/homebrew/bin/uv run python servers/mcp-scenarios.py"
      ],
      "env": {
        "AWS_PROFILE": "dev-sso-gen-agent-ro"
      }
    },
    "gacs": {
      "command": "bash",
      "args": [
        "-c",
        "_DIR=${MCP_REPO_DIR:-$HOME/code/generative-agent-optimization-mcp}; cd \"$_DIR\" && exec /opt/homebrew/bin/uv run python servers/mcp-gacs.py"
      ],
      "env": {
        "AWS_PROFILE": "dev-sso-gen-agent-ro"
      }
    },
    "data-sampling": {
      "command": "bash",
      "args": [
        "-c",
        "_DIR=${MCP_REPO_DIR:-$HOME/code/generative-agent-optimization-mcp}; cd \"$_DIR\" && exec /opt/homebrew/bin/uv run python servers/mcp-data-sampling.py"
      ],
      "env": {
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "genagent-prompt-renderer": {
      "command": "bash",
      "args": [
        "-c",
        "_DIR=${MCP_REPO_DIR:-$HOME/code/generative-agent-optimization-mcp}; cd \"$_DIR\" && exec /opt/homebrew/bin/uv run python servers/mcp-genagent-prompt-renderer.py"
      ],
      "env": {
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
