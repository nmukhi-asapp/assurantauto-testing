# ============================================================
# AssurantAuto Testing & Analysis — Environment Configuration
# ============================================================
#
# Setup:
#   1. cp .env-sample .env
#   2. Fill in your values (see README for credential sources)
#   3. Never commit .env (it is in .gitignore)

# ────────────────────────────────────────────────────────────
# Sibling repo paths (only needed if NOT cloned to ~/code/)
# Defaults assume all repos are siblings of this one.
# ────────────────────────────────────────────────────────────
# MCP_REPO_DIR="/path/to/generative-agent-optimization-mcp"
# VOICE_GENAGENT_DIR="/path/to/voice-genagent"
# TIME_INSPECTOR_DIR="/path/to/generative-agent-time-inspector"
# GENERATIVE_AGENT_DIR="/path/to/generative-agent"

# ────────────────────────────────────────────────────────────
# LiteLLM  (required for MCP scenario/evaluation tools)
# Get from 1Password: search "LiteLLM"
# ────────────────────────────────────────────────────────────
LITELLM_URL="https://litellm.asapp.com/"
LITELLM_API_KEY="your-litellm-api-key-here"

# ────────────────────────────────────────────────────────────
# Voice scenario runner — choose one provider
# ────────────────────────────────────────────────────────────

# VAPI (preferred for voice simulations)
VAPI_API_KEY="your-vapi-api-key-here"
VAPI_CREATE_CALL_TIMEOUT_SEC=30.0
VAPI_WEBSOCKET_OPEN_TIMEOUT_SEC=30.0

# OpenAI (alternative voice provider)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_ORG_ID="your-openai-org-id-here"

# ────────────────────────────────────────────────────────────
# AWS (required for Athena conversation fetching and GACS)
# Configure via: aws sso login --profile dev-sso-gen-agent-ro
# ────────────────────────────────────────────────────────────
# AWS_PROFILE is set per-server in .mcp.json — no value needed here
# DATA_SAMPLING_TEAM controls which Athena role is assumed
DATA_SAMPLING_TEAM="research"

# ────────────────────────────────────────────────────────────
# Langfuse  (optional — observability & tracing)
# Contact Akshay for access
# ────────────────────────────────────────────────────────────
LANGFUSE_ENABLED="false"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key-here"
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key-here"
LANGFUSE_HOST="https://langfuse.shared.asapp.dev"
LANGFUSE_PROJECT="GAO-Evals"
LANGFUSE_ENVIRONMENT="development"
